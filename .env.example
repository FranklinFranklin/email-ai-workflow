# ── Applicatie ──────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
APP_SECRET_KEY=change-me-min-32-chars-random-string
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=emailai
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=emailai_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-password
REDIS_DB=0

# ── Versleuteling (kolomniveau PII) ──────────────────────────────────────────
# Genereer met: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-key-base64

# ── LLM — kies één provider ──────────────────────────────────────────────────
# "anthropic" = Anthropic Claude via API (standaard, vereist API-sleutel)
# "ollama"    = Lokaal model via Ollama (geen API-sleutel, geen internet nodig)
LLM_PROVIDER=anthropic

# ── Anthropic (actief als LLM_PROVIDER=anthropic) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=30

# ── Ollama (actief als LLM_PROVIDER=ollama) ───────────────────────────────────
# Installeer Ollama via https://ollama.com — draait standaard op poort 11434
# Download een model: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ── LLM (OpenAI — fallback) ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Gmail API ──────────────────────────────────────────────────────────────────
# Scopes: gmail.readonly + gmail.labels  NOOIT gmail.send
GMAIL_CLIENT_ID=...apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-...
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback
GMAIL_PUBSUB_TOPIC=projects/my-project/topics/gmail-push

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Worker (RQ) ───────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
EMAIL_PROCESSING_QUEUE=email_processing
EMAIL_PROCESSING_TIMEOUT=300

# ── Retentiebeleid (dagen) ────────────────────────────────────────────────────
EMAIL_RETENTION_DAYS=365
DRAFT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=2555   # 7 jaar voor compliance

# ── Beveiliging ───────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
MAX_EMAIL_SIZE_BYTES=10485760   # 10 MB

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
