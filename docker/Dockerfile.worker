FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Installeer systeemvereisten
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Installeer Python afhankelijkheden
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Download spaCy Nederlands taalmodel voor Presidio PII-detectie
RUN python -m spacy download nl_core_news_sm

# Kopieer applicatiecode
COPY . .

# Beveiliging: draai niet als root
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

CMD ["rq", "worker", "-u", "redis://redis:6379/0", "email_processing"]
